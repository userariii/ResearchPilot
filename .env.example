# ResearchPilot Environment Configuration

# Database
DATABASE_URL=sqlite:///./research_pilot.db

# AI Provider Configuration ('auto', 'ensemble', 'gemini', 'openai', or 'mock')
# 'auto' or 'ensemble' automatically combines and mixes results from all configured models
AI_PROVIDER=auto

# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=
# Specify one or multiple Gemini models offered (comma-separated)
GEMINI_MODEL=gemini-3.8-flash, gemini-3.5-flash

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=
# Specify one or multiple OpenAI models offered (comma-separated)
OPENAI_MODEL=gpt-4o-mini, gpt-4o
# OPENAI_BASE_URL=

# Web Search Provider ('auto', 'tavily', or 'mock')
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
