# ResearchPilot Environment Configuration

# Database
DATABASE_URL=sqlite:///./research_pilot.db

# AI Provider Configuration ('gemini', 'openai', or 'mock')
# Leave empty or set to 'mock' to run the autonomous workflow in self-contained demo/mock mode
AI_PROVIDER=auto

# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Web Search Provider ('tavily' or 'mock')
# Tavily API Key (https://tavily.com/)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

