{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "researchpilot-beta",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "AI_PROVIDER": "auto",
    "SEARCH_PROVIDER": "auto",
    "GEMINI_MODEL": "gemini-3.8-flash, gemini-3.5-flash",
    "OPENAI_MODEL": "gpt-4o-mini, gpt-4o",
    "CORS_ORIGIN": "*"
  }
  // To connect a persistent Cloudflare D1 Database:
  // 1. Create a D1 database in Cloudflare Dashboard (Storage & Databases -> D1)
  //    or run: npx wrangler d1 create research-pilot-db
  // 2. Paste your real database_id below and uncomment the block:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "research-pilot-db",
  //     "database_id": "<your-actual-d1-uuid-here>"
  //   }
  // ]
}
